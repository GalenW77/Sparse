import torch
import torch.nn as nn
from sparseconvnet import SparseConv2d, denseToSparse, sparseToDense  # SparseConvNet
from networks.transunet import Attention  # TransUNet-Attention


# 1. Sparse MLP
class SparseMLP(nn.Module):
    def __init__(self, in_features, hidden_features=None, out_features=None, drop=0., spatial_size=16):
        super().__init__()
        out_features = out_features or in_features
        hidden_features = hidden_features or in_features
        self.spatial_size = spatial_size  # TransUNet Decoder

        # SparseConv2d
        self.sparse_conv1 = SparseConv2d(
            in_channels=in_features,
            out_channels=hidden_features,
            kernel_size=1,
            stride=1,
            padding=0,
            dilation=1,
            bias=True
        )
        self.act = nn.GELU()  # TransUNet-MLP
        self.drop = nn.Dropout(drop)  # 与TransUNet-MLP-Dropout
        self.sparse_conv2 = SparseConv2d(
            in_channels=hidden_features,
            out_channels=out_features,
            kernel_size=1,
            stride=1,
            padding=0,
            dilation=1,
            bias=True
        )

    def forward(self, x):
        # [B, N, C] → [B, C, H, W]
        B, N, C = x.shape
        x = x.permute(0, 2, 1).reshape(B, C, self.spatial_size, self.spatial_size) 

        # 密集→稀疏→卷积→激活→卷积→稀疏→密集
        x_sparse = denseToSparse(x)
        x_sparse = self.sparse_conv1(x_sparse)
        x_sparse = self.act(x_sparse)
        x_sparse = self.drop(x_sparse)
        x_sparse = self.sparse_conv2(x_sparse)
        x = sparseToDense(x_sparse, self.spatial_size)  

        x = x.reshape(B, C, N).permute(0, 2, 1)
        return x


# 2.Decoder Block
class MaskedCrossAttentionDecoderBlock_Plan1(nn.Module):
    def __init__(self, dim, num_heads, mlp_ratio=4., qkv_bias=False, qk_scale=None, dropout=0., attn_dropout=0.,
                 spatial_size=16):
        super().__init__()
        # Norm + Sparse MLP
        self.norm1 = nn.LayerNorm(dim, eps=1e-6)  # TransUNet-LayerNorm
        self.mlp = SparseMLP(
            in_features=dim,
            hidden_features=int(dim * mlp_ratio),
            out_features=dim,
            drop=dropout,
            spatial_size=spatial_size
        )
        self.dropout1 = nn.Dropout(dropout)  # TransUNet

        # Norm + MHSA
        self.norm2 = nn.LayerNorm(dim, eps=1e-6)  # TransUNet-LayerNorm
        self.mhsa = Attention(  # TransUNet-Attention
            dim=dim,
            num_heads=num_heads,
            qkv_bias=qkv_bias,
            qk_scale=qk_scale,
            attn_drop=attn_dropout,
            proj_drop=dropout
        )
        self.dropout2 = nn.Dropout(dropout)  # TransUNet

    def forward(self, features, query, mask=None):
        # Sparse MLP
        query = query + self.dropout1(self.mlp(self.norm1(query)))

        # MHSA
        cross_attn_output = self.mhsa(self.norm2(query), mask=mask,
                                      encoder_features=features)  # 适配TransUNet Attention的cross-attention用法
        query = query + self.dropout2(cross_attn_output)

        return query
